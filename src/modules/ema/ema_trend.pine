//@version=6
indicator("Module: EMA Trend (example)", shorttitle="MOD-EMA", overlay=true)
ema50 = ta.ema(close, 50)
ema100 = ta.ema(close, 100)
ema200 = ta.ema(close, 200)
bull = (ema50 > ema100) and (ema100 > ema200)
bear = (ema200 > ema100) and (ema100 > ema50)
plot(ema50, "EMA50", color=bull ? color.lime : bear ? color.red : color.gray, linewidth=2)
plot(ema100, "EMA100", color=color.new(color.gray, 20))
plot(ema200, "EMA200", color=color.new(color.gray, 40))
