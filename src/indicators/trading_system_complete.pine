//@version=6
indicator("🎯 Pine v6 Trading System - Complete", 
     shorttitle="PineV6 System",
     overlay=true, 
     max_labels_count=500,
     max_lines_count=500,
     max_boxes_count=500)

// ═══════════════════════════════════════════════════════════════════════
// 🎨 GLOBAL STYLE - COLOR PALETTE
// ═══════════════════════════════════════════════════════════════════════

color COLOR_GOLD = #D4AF37
color COLOR_BLACK = #141414
color COLOR_GREEN = #089981
color COLOR_RED = #F23645

// ═══════════════════════════════════════════════════════════════════════
// 🧭 GLOBAL MODE SETTINGS
// ═══════════════════════════════════════════════════════════════════════

string styleMode = input.string("Pro", "📊 Trading Style", 
     options=["Pro", "Aggressive"], 
     group="🧭 Global Mode")

string strategyMode = input.string("Intraday", "⏰ Strategy Mode", 
     options=["Scalp", "Intraday", "Swing"], 
     group="🧭 Global Mode")

// Adaptive parameters based on mode
int emaLen = strategyMode == "Scalp" ? 9 : strategyMode == "Intraday" ? 9 : 20
int ema50Len = strategyMode == "Scalp" ? 50 : strategyMode == "Intraday" ? 50 : 50
int ema100Len = strategyMode == "Scalp" ? 100 : strategyMode == "Intraday" ? 100 : 100
int ema200Len = strategyMode == "Scalp" ? 200 : strategyMode == "Intraday" ? 200 : 200

// ═══════════════════════════════════════════════════════════════════════
// 📊 MODULE TOGGLES
// ═══════════════════════════════════════════════════════════════════════

// Visibility toggles
bool showEMA = input.bool(true, "📐 Show EMA", group="👁️ Visibility")
bool showVWAP = input.bool(true, "📍 Show VWAP", group="👁️ Visibility")
bool showSupertrend = input.bool(true, "📈 Show Supertrend", group="👁️ Visibility")
bool showDailyOpen = input.bool(true, "🟦 Show Daily Open", group="👁️ Visibility")
bool showDashboard = input.bool(true, "📊 Show Dashboard", group="👁️ Visibility")

// Confluence impact toggles
bool emaConfluence = input.bool(true, "📐 EMA → Confluence", group="⚡ Confluence Impact")
bool vwapConfluence = input.bool(true, "📍 VWAP → Confluence", group="⚡ Confluence Impact")
bool supertrendConfluence = input.bool(true, "📈 Supertrend → Confluence", group="⚡ Confluence Impact")
bool structureConfluence = input.bool(true, "🔹 Structure → Confluence", group="⚡ Confluence Impact")

// ═══════════════════════════════════════════════════════════════════════
// 📐 EMA MODULE
// ═══════════════════════════════════════════════════════════════════════

float ema9 = ta.ema(close, emaLen)
float ema50 = ta.ema(close, ema50Len)
float ema100 = ta.ema(close, ema100Len)
float ema200 = ta.ema(close, ema200Len)

// EMA Trend state
bool emaBull = ema50 > ema100 and ema100 > ema200
bool emaBear = ema50 < ema100 and ema100 < ema200
int emaTrend = emaBull ? 1 : emaBear ? -1 : 0

// EMA9 Momentum
bool ema9Bull = close > ema9
int ema9Momentum = ema9Bull ? 1 : -1

// Plot EMAs
plot(showEMA ? ema9 : na, "EMA 9", COLOR_GOLD, 1)
plot(showEMA ? ema50 : na, "EMA 50", color.new(COLOR_GREEN, 40), 2)
plot(showEMA ? ema100 : na, "EMA 100", color.new(color.blue, 40), 2)
plot(showEMA ? ema200 : na, "EMA 200", color.new(COLOR_RED, 40), 2)

// EMA Confluence score
float emaScore = emaTrend * 70 + ema9Momentum * 30
float emaConfluenceScore = emaConfluence ? emaScore : 0

// ═══════════════════════════════════════════════════════════════════════
// 📍 VWAP MODULE
// ═══════════════════════════════════════════════════════════════════════

float vwapValue = ta.vwap(hlc3)

// VWAP direction
bool vwapBull = close > vwapValue
int vwapDirection = vwapBull ? 1 : -1

// Plot VWAP
color vwapColor = vwapBull ? COLOR_GREEN : COLOR_RED
plot(showVWAP ? vwapValue : na, "VWAP", vwapColor, 2, plot.style_circles)

// VWAP Confluence score
float vwapScore = vwapDirection * 60
float vwapConfluenceScore = vwapConfluence ? vwapScore : 0

// ═══════════════════════════════════════════════════════════════════════
// 📈 SUPERTREND MODULE
// ═══════════════════════════════════════════════════════════════════════

int stPeriod = input.int(10, "Supertrend Period", group="📈 Supertrend")
float stMultiplier = input.float(3.0, "Supertrend Multiplier", group="📈 Supertrend")

[supertrendValue, supertrendDir] = ta.supertrend(stMultiplier, stPeriod)
int stTrend = supertrendDir < 0 ? 1 : -1

// Plot Supertrend
color stColor = stTrend == 1 ? COLOR_GREEN : COLOR_RED
plot(showSupertrend ? supertrendValue : na, "Supertrend", stColor, 2)

// Supertrend cloud
fill(plot(showSupertrend ? close : na, display=display.none), 
     plot(showSupertrend ? supertrendValue : na, display=display.none),
     color=stTrend == 1 ? color.new(COLOR_GREEN, 90) : color.new(COLOR_RED, 90))

// Supertrend Confluence score
float stScore = stTrend * 80
float stConfluenceScore = supertrendConfluence ? stScore : 0

// ═══════════════════════════════════════════════════════════════════════
// 🟦 DAILY OPEN MODULE
// ═══════════════════════════════════════════════════════════════════════

float dailyOpen = request.security(syminfo.tickerid, "D", open, barmerge.gaps_off, barmerge.lookahead_on)

// Daily Open status
bool aboveDO = close > dailyOpen
int doStatus = aboveDO ? 1 : -1

// Plot Daily Open
plot(showDailyOpen ? dailyOpen : na, "Daily Open", 
     color.new(COLOR_GOLD, 30), 1, plot.style_circles)

// ═══════════════════════════════════════════════════════════════════════
// 📊 VOLUME CONTROL MODULE
// ═══════════════════════════════════════════════════════════════════════

int volPeriod = 20
float volAvg = ta.sma(volume, volPeriod)
bool highVolume = volume > volAvg * 1.5

// Buying/Selling pressure (simplified)
float buyPressure = close > open ? volume : 0
float sellPressure = close < open ? volume : 0
float buyAvg = ta.sma(buyPressure, volPeriod)
float sellAvg = ta.sma(sellPressure, volPeriod)

float buyPercent = (buyAvg / (buyAvg + sellAvg)) * 100
float sellPercent = 100 - buyPercent

int volDirection = buyPercent > 55 ? 1 : buyPercent < 45 ? -1 : 0

// ═══════════════════════════════════════════════════════════════════════
// 🔹 STRUCTURE MODULE (Simplified)
// ═══════════════════════════════════════════════════════════════════════

int structureBacktrack = 5
float ph = ta.pivothigh(high, structureBacktrack, structureBacktrack)
float pl = ta.pivotlow(low, structureBacktrack, structureBacktrack)

var float lastHigh = na
var float lastLow = na

if not na(ph)
    lastHigh := ph
if not na(pl)
    lastLow := pl

// Structure state (simplified)
int structureState = close > lastHigh ? 1 : close < lastLow ? -1 : 0

// Structure Confluence score
float structureScore = structureState * 75
float structureConfluenceScore = structureConfluence ? structureScore : 0

// ═══════════════════════════════════════════════════════════════════════
// 🧠 CONFLUENCE ENGINE
// ═══════════════════════════════════════════════════════════════════════

// Weights
float wEMA = 0.15
float wVWAP = 0.10
float wST = 0.20
float wStructure = 0.20
float wVolume = 0.10
float wDO = 0.10
float wOther = 0.15

// Calculate weighted confluence
float confluenceRaw = 
     emaConfluenceScore * wEMA +
     vwapConfluenceScore * wVWAP +
     stConfluenceScore * wST +
     structureConfluenceScore * wStructure +
     (volDirection * 50) * wVolume +
     (doStatus * 40) * wDO

float confluenceScore = math.abs(confluenceRaw)
int confluenceDirection = confluenceRaw > 0 ? 1 : confluenceRaw < 0 ? -1 : 0

// Thresholds
int buyThreshold = input.int(60, "BUY Threshold", group="🧠 Confluence")
int sellThreshold = input.int(60, "SELL Threshold", group="🧠 Confluence")

// Signal generation
string signal = "WAIT"
if confluenceScore >= buyThreshold and confluenceDirection == 1
    signal := "BUY"
else if confluenceScore >= sellThreshold and confluenceDirection == -1
    signal := "SELL"

bool newBuy = signal == "BUY" and signal[1] != "BUY"
bool newSell = signal == "SELL" and signal[1] != "SELL"

// Plot signals
plotshape(newBuy, "BUY", shape.labelup, location.belowbar, COLOR_GREEN, 
     text="BUY", textcolor=color.white, size=size.normal)
plotshape(newSell, "SELL", shape.labeldown, location.abovebar, COLOR_RED, 
     text="SELL", textcolor=color.white, size=size.normal)

// Background
bgcolor(signal == "BUY" ? color.new(COLOR_GREEN, 97) : 
        signal == "SELL" ? color.new(COLOR_RED, 97) : na)

// ═══════════════════════════════════════════════════════════════════════
// 💰 RISK MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════

int atrPeriod = 14
float atrValue = ta.atr(atrPeriod)
float atrMultiplier = 2.0

float stopLoss = na
float takeProfit = na

if signal == "BUY"
    stopLoss := close - (atrValue * atrMultiplier)
    takeProfit := close + (atrValue * atrMultiplier * 2.5)
else if signal == "SELL"
    stopLoss := close + (atrValue * atrMultiplier)
    takeProfit := close - (atrValue * atrMultiplier * 2.5)

// Plot SL/TP
plot(stopLoss, "Stop Loss", COLOR_RED, 2, plot.style_cross)
plot(takeProfit, "Take Profit", COLOR_GREEN, 2, plot.style_cross)

// ═══════════════════════════════════════════════════════════════════════
// 📊 DASHBOARD
// ═══════════════════════════════════════════════════════════════════════

var table dashboard = table.new(position.bottom_left, 3, 12, 
     bgcolor=color.new(COLOR_BLACK, 85),
     border_color=color.new(COLOR_GOLD, 0),
     border_width=2)

if showDashboard and barstate.islast
    // Header
    table.cell(dashboard, 0, 0, "📊 SYSTEM", text_color=COLOR_GOLD, text_size=size.normal)
    table.cell(dashboard, 1, 0, "STATUS", text_color=COLOR_GOLD, text_size=size.normal)
    table.cell(dashboard, 2, 0, "VALUE", text_color=COLOR_GOLD, text_size=size.normal)
    
    // Confluence
    color sigColor = signal == "BUY" ? COLOR_GREEN : signal == "SELL" ? COLOR_RED : COLOR_GOLD
    table.cell(dashboard, 0, 1, "🧠 CONFLUENCE", text_color=COLOR_GOLD, text_size=size.small)
    table.cell(dashboard, 1, 1, signal, text_color=sigColor, text_size=size.small)
    table.cell(dashboard, 2, 1, str.tostring(confluenceScore, "#") + "%", text_color=sigColor, text_size=size.small)
    
    // Mode
    table.cell(dashboard, 0, 2, "🧭 MODE", text_color=COLOR_GOLD, text_size=size.small)
    table.cell(dashboard, 1, 2, styleMode, text_color=color.white, text_size=size.small)
    table.cell(dashboard, 2, 2, strategyMode, text_color=color.white, text_size=size.small)
    
    // EMA Trend
    table.cell(dashboard, 0, 3, "📐 EMA", text_color=COLOR_GOLD, text_size=size.small)
    string emaTxt = emaTrend == 1 ? "🟢 BULL" : emaTrend == -1 ? "🔴 BEAR" : "⚪ NEUTRAL"
    table.cell(dashboard, 1, 3, emaTxt, text_color=color.white, text_size=size.small)
    
    // VWAP
    table.cell(dashboard, 0, 4, "📍 VWAP", text_color=COLOR_GOLD, text_size=size.small)
    string vwapTxt = vwapDirection == 1 ? "🟢 ABOVE" : "🔴 BELOW"
    table.cell(dashboard, 1, 4, vwapTxt, text_color=color.white, text_size=size.small)
    
    // Supertrend
    table.cell(dashboard, 0, 5, "📈 SUPERTREND", text_color=COLOR_GOLD, text_size=size.small)
    string stTxt = stTrend == 1 ? "🟢 BULL" : "🔴 BEAR"
    table.cell(dashboard, 1, 5, stTxt, text_color=color.white, text_size=size.small)
    
    // Structure
    table.cell(dashboard, 0, 6, "🔹 STRUCTURE", text_color=COLOR_GOLD, text_size=size.small)
    string structTxt = structureState == 1 ? "🟢 HH/HL" : structureState == -1 ? "🔴 LH/LL" : "⚪ MIXED"
    table.cell(dashboard, 1, 6, structTxt, text_color=color.white, text_size=size.small)
    
    // Volume
    table.cell(dashboard, 0, 7, "📊 VOLUME", text_color=COLOR_GOLD, text_size=size.small)
    string volTxt = str.tostring(buyPercent, "#") + "% / " + str.tostring(sellPercent, "#") + "%"
    table.cell(dashboard, 1, 7, volTxt, text_color=color.white, text_size=size.small)
    
    // Daily Open
    table.cell(dashboard, 0, 8, "🟦 DAILY OPEN", text_color=COLOR_GOLD, text_size=size.small)
    string doTxt = aboveDO ? "🟢 ABOVE" : "🔴 BELOW"
    table.cell(dashboard, 1, 8, doTxt, text_color=color.white, text_size=size.small)
    
    // ATR
    table.cell(dashboard, 0, 9, "📏 ATR", text_color=COLOR_GOLD, text_size=size.small)
    table.cell(dashboard, 1, 9, str.tostring(atrValue, "#.####"), text_color=color.white, text_size=size.small)
    
    // Risk
    if signal != "WAIT"
        table.cell(dashboard, 0, 10, "💰 RISK", text_color=COLOR_GOLD, text_size=size.small)
        float rrRatio = math.abs((takeProfit - close) / (close - stopLoss))
        string riskTxt = "RR 1:" + str.tostring(rrRatio, "#.#")
        table.cell(dashboard, 1, 10, riskTxt, text_color=COLOR_GREEN, text_size=size.small)

// ═══════════════════════════════════════════════════════════════════════
// 🔔 ALERTS
// ═══════════════════════════════════════════════════════════════════════

alertcondition(newBuy, "BUY Signal", "🟢 BUY Signal - Confluence: {{plot_0}}%")
alertcondition(newSell, "SELL Signal", "🔴 SELL Signal - Confluence: {{plot_0}}%")
